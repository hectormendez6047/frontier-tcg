# Copy these into Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your live site address (no trailing slash). Used for SEO links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://frontiertcgshop.com

# ── Checkout (Square) ──
SQUARE_ENVIRONMENT=sandbox                 # change to "production" with production keys to take real payments
SQUARE_ACCESS_TOKEN=                       # Secret. Square Developer Console → your app → Credentials
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Secret. Supabase → Project Settings → API Keys → secret key (sb_secret_…) or legacy service_role key.
# Used only on the server to record orders and refunds.
SUPABASE_SERVICE_ROLE_KEY=

# ── Order emails (optional until launch) ──
RESEND_API_KEY=                            # Secret. resend.com → API Keys
EMAIL_FROM="Frontier TCG <orders@frontiertcgshop.com>"
